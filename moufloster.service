[Unit]
Description=Moufloster - TheMovieDB Poster Generator
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/moufloster
# Note : "%i" ici est un reste visiblement involontaire (c'est une syntaxe
# de service systemd "template", sans effet dans un service normal comme
# celui-ci) — la vraie clé TMDB est de toute façon chargée depuis
# data/secrets.env via set-secret.sh, pas depuis cette variable. Sans danger
# en l'état, mais à nettoyer si l'occasion se présente.
Environment="TMDB_API_KEY=%i"
Environment="OUTPUT_DIR=/mnt/mouflosyno/MouFloster"
ExecStart=/opt/moufloster/venv/bin/python app.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/moufloster.log
StandardError=append:/var/log/moufloster.log

[Install]
WantedBy=multi-user.target
